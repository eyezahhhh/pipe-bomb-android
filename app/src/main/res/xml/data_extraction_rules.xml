<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules. Diagnostics logs stay on the device; they are never
   included in cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diagnostics/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diagnostics/" />
    </device-transfer>
</data-extraction-rules>
